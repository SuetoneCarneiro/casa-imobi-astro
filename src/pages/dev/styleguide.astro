---
import PropertyCard from '../../components/site/PropertyCard.astro'
import SearchBar from '../../components/site/SearchBar.astro'
import Badge from '../../components/ui/Badge.astro'
import Button from '../../components/ui/Button.astro'
import Card from '../../components/ui/Card.astro'
import Checkbox from '../../components/ui/Checkbox.astro'
import Icon, { type IconName } from '../../components/ui/Icon.astro'
import Input from '../../components/ui/Input.astro'
import Section from '../../components/ui/Section.astro'
import Select from '../../components/ui/Select.astro'
import Textarea from '../../components/ui/Textarea.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import type { Property } from '../../server/db/schema'

// Página de desenvolvimento. Em produção não existe.
if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 })
}

const now = Date.now()
const exemplo: Property = {
  id: 1,
  code: 'CI-0001',
  title: 'Casa com 3 quartos e suíte no Maurício de Nassau',
  slug: 'casa-3-quartos-suite-mauricio-de-nassau',
  description: 'Casa térrea em rua tranquila, com quintal nos fundos.',
  price: 45000000,
  purpose: 'sale',
  type: 'house',
  category: 'residential',
  status: 'active',
  isCondo: false,
  bedrooms: 3,
  suites: 1,
  bathrooms: 2,
  parkingSpaces: 2,
  usableArea: 180,
  addressStreet: 'Rua Rádio Clube de Pernambuco',
  addressNumber: '212',
  hideAddressNumber: true,
  addressNeighborhood: 'Maurício de Nassau',
  addressCity: 'Caruaru',
  addressState: 'PE',
  addressZip: '55012-530',
  development: null,
  videoUrl: null,
  createdBy: 1,
  createdAt: now,
  updatedAt: now,
}

const semFoto: Property = {
  ...exemplo,
  id: 2,
  code: 'CI-0004',
  title: 'Terreno 12x30 no Petrópolis',
  slug: 'terreno-12x30-petropolis',
  type: 'land',
  price: 19000000,
  bedrooms: 0,
  suites: 0,
  bathrooms: 0,
  parkingSpaces: 0,
  usableArea: 360,
  addressNeighborhood: 'Petrópolis',
  isCondo: true,
}

const brandScale = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950]
const icons: IconName[] = [
  'home', 'building', 'land', 'store', 'bed', 'bath', 'car', 'area',
  'phone', 'mail', 'pin', 'search', 'menu', 'close', 'arrow-right', 'check',
  'whatsapp', 'instagram', 'facebook', 'youtube',
]
---

<SiteLayout title="Styleguide — CasaImobi" description="Componentes e tokens do projeto.">
  <Section eyebrow="Fase 2" title="Design system" description="Tokens e componentes do projeto. Esta página só existe em desenvolvimento." tone="white" />

  <Section title="Cores">
    <!--
      Amostras usam style + var(--color-*), não bg-brand-{step}: o Tailwind
      escaneia o código como texto e nunca geraria uma classe montada em runtime.
      Os tokens do @theme existem como variáveis CSS de verdade, então funciona.
    -->
    <div class="flex flex-col gap-8">
      <div>
        <h3 class="mb-3 text-sm font-semibold">brand — roxo institucional</h3>
        <div class="grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-11">
          {brandScale.map((step) => (
            <div>
              <div class="h-14 rounded-lg border border-brand-900/10" style={`background-color: var(--color-brand-${step})`}></div>
              <p class="mt-1.5 font-mono text-[11px] text-ink-soft">{step}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-sm font-semibold">gold — acento</h3>
        <div class="grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-11">
          {brandScale.map((step) => (
            <div>
              <div class="h-14 rounded-lg border border-brand-900/10" style={`background-color: var(--color-gold-${step})`}></div>
              <p class="mt-1.5 font-mono text-[11px] text-ink-soft">{step}</p>
            </div>
          ))}
        </div>
      </div>

      <Card class="border-gold-200 bg-gold-50">
        <p class="text-sm text-gold-900">
          <strong>Regra de contraste:</strong> <code class="font-mono">gold-500</code> sobre branco dá
          2,4:1 e reprova para texto. Como texto em fundo claro, use
          <code class="font-mono">gold-700</code> ou mais escuro. Sobre
          <code class="font-mono">brand-900</code> o dourado passa em AA.
        </p>
      </Card>
    </div>
  </Section>

  <Section title="Tipografia" tone="white">
    <div class="flex flex-col gap-5">
      <div>
        <p class="mb-1 font-mono text-xs text-ink-soft">Outfit · display · títulos e preços</p>
        <p class="font-display text-4xl font-bold">Imóveis em Caruaru</p>
        <p class="font-display text-2xl font-semibold">Casa com 3 quartos e suíte</p>
      </div>
      <div>
        <p class="mb-1 font-mono text-xs text-ink-soft">Public Sans · texto corrido e formulários</p>
        <p class="max-w-prose">
          Casa térrea em rua tranquila, próxima ao Colégio Diocesano. Sala ampla em dois ambientes,
          cozinha com armários planejados e quintal nos fundos. Acentuação conferida: ção, ã, õe, é, ú.
        </p>
      </div>
    </div>
  </Section>

  <Section title="Botões">
    <div class="flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <Button>Primário</Button>
        <Button variant="secondary">Secundário</Button>
        <Button variant="ghost">Ghost</Button>
        <Button variant="whatsapp"><Icon name="whatsapp" size={17} />WhatsApp</Button>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Button size="sm">Pequeno</Button>
        <Button size="md">Médio</Button>
        <Button size="lg">Grande</Button>
        <Button disabled>Desabilitado</Button>
        <Button href="/imoveis" variant="secondary">Vira link com href<Icon name="arrow-right" size={16} /></Button>
      </div>
    </div>
  </Section>

  <Section title="Etiquetas" tone="white">
    <div class="flex flex-wrap gap-2">
      <Badge>Casa</Badge>
      <Badge variant="brand">Destaque</Badge>
      <Badge variant="gold">Condomínio</Badge>
      <Badge variant="muted">Inativo</Badge>
    </div>
  </Section>

  <Section title="Formulário">
    <div class="grid max-w-3xl gap-5 sm:grid-cols-2">
      <Input name="nome" label="Nome" placeholder="Seu nome" required />
      <Input name="telefone" label="Telefone" type="tel" placeholder="(81) 90000-0000" hint="Usamos só para retornar contato." />
      <Select name="tipo_demo" label="Tipo de imóvel" placeholder="Selecione" options={[{ value: 'house', label: 'Casa' }, { value: 'apartment', label: 'Apartamento' }]} />
      <Input name="erro" label="Campo com erro" error="Informe um e-mail válido." value="joao@" />
      <Textarea name="mensagem" label="Mensagem" class="sm:col-span-2" placeholder="Conte o que você procura" />
      <Checkbox name="aceite" label="Quero receber novidades no WhatsApp" hint="Pode cancelar quando quiser." class="sm:col-span-2" />
    </div>
  </Section>

  <Section title="Busca" tone="white" description="GET, então o resultado vira URL compartilhável.">
    <SearchBar />
  </Section>

  <Section title="Card de imóvel" description="Com foto e sem foto — o segundo é o estado real de um imóvel recém-cadastrado.">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <PropertyCard property={exemplo} coverUrl="/logo-casaimobi-web.png" />
      <PropertyCard property={semFoto} />
    </div>
  </Section>

  <Section title="Ícones" tone="white">
    <ul class="grid grid-cols-4 gap-4 sm:grid-cols-6 lg:grid-cols-10">
      {icons.map((name) => (
        <li class="flex flex-col items-center gap-1.5 rounded-lg border border-brand-100 bg-white p-3">
          <Icon name={name} size={22} class="text-ink" />
          <span class="font-mono text-[10px] text-ink-soft">{name}</span>
        </li>
      ))}
    </ul>
  </Section>
</SiteLayout>
