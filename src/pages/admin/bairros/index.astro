---
import { env } from 'cloudflare:workers'
import Button from '../../../components/ui/Button.astro'
import Icon from '../../../components/ui/Icon.astro'
import Input from '../../../components/ui/Input.astro'
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { destinoSeguro } from '../../../lib/retorno'
import { createDb } from '../../../server/db/client'
import { listNeighborhoodsComUso } from '../../../server/db/queries/neighborhoods'
import { podeEditarBairros } from '../../../server/services/permissions'
import { criarBairro } from '../../../server/services/neighborhoods'
import { parseBairro } from '../../../server/validation/neighborhood'

const user = Astro.locals.user!
const db = createDb(env.DB)
const podeEditar = podeEditarBairros(user)

/** De onde a pessoa veio, para ser devolvida ao cadastro que preenchia. */
const voltar = destinoSeguro(Astro.url.searchParams.get('voltar'))

let erro: string | null = null
let campo: string | null = null
let valor = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  valor = String(form.get('name') ?? '')

  const parsed = parseBairro(form)
  if (parsed.success) {
    const resultado = await criarBairro(db, parsed.data.name)
    if (resultado.ok) {
      // Volta para o cadastro já com o bairro novo escolhido. Sem `voltar`,
      // a pessoa veio pelo menu e fica aqui mesmo.
      const destino = voltar
        ? `${voltar}?bairro-novo=${resultado.bairro.id}`
        : `/admin/bairros?criado=${encodeURIComponent(resultado.bairro.name)}`
      return Astro.redirect(destino, 303)
    }
    erro = resultado.erro
  } else {
    campo = parsed.error.issues[0]?.message ?? 'Confira o nome informado.'
  }
}

const bairros = await listNeighborhoodsComUso(db)
const aviso =
  Astro.url.searchParams.get('criado') ??
  Astro.url.searchParams.get('salvo') ??
  Astro.url.searchParams.get('removido')
const acao = Astro.url.searchParams.has('removido')
  ? 'removido'
  : Astro.url.searchParams.has('salvo')
    ? 'salvo'
    : 'cadastrado'
---

<AdminLayout title="Bairros">
  <header class="mb-8">
    {
      voltar && (
        <a href={`${voltar}?restaurar=1`} class="text-sm text-ink-muted hover:text-ink">
          ← Voltar ao cadastro do imóvel
        </a>
      )
    }
    <h1 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">Bairros</h1>
    <p class="mt-1 text-sm text-ink-muted">
      {bairros.length} {bairros.length === 1 ? 'bairro cadastrado' : 'bairros cadastrados'}. É esta
      lista que aparece no cadastro de imóveis.
    </p>
  </header>

  {
    aviso && (
      <p role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        Bairro {aviso} {acao}.
      </p>
    )
  }

  <section class="mb-10 max-w-lg rounded-xl border border-brand-100 bg-white p-6 shadow-sm">
    <h2 class="font-display text-lg font-semibold text-ink">Novo bairro</h2>

    {
      erro && (
        <p role="alert" class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-700">
          {erro}
        </p>
      )
    }

    <form method="post" class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-start">
      <Input name="name" label="Nome" required value={valor} error={campo ?? undefined} class="flex-1" />
      <Button type="submit" class="sm:mt-7">
        <Icon name="plus" size={16} />
        Cadastrar
      </Button>
    </form>
  </section>

  <div class="overflow-hidden rounded-xl border border-brand-100 bg-white shadow-sm">
    <table class="w-full text-sm">
      <thead class="border-b border-brand-100 text-left text-xs tracking-wide text-ink-muted uppercase">
        <tr>
          <th class="px-5 py-3 font-medium">Bairro</th>
          <th class="px-5 py-3 font-medium">Imóveis</th>
          {podeEditar && <th class="px-5 py-3"><span class="sr-only">Ações</span></th>}
        </tr>
      </thead>
      <tbody>
        {
          bairros.map((b) => (
            <tr class="border-b border-brand-50 last:border-0">
              <td class="px-5 py-3.5 font-medium text-ink">{b.name}</td>
              <td class="px-5 py-3.5 text-ink-muted">{b.imoveis}</td>
              {podeEditar && (
                <td class="px-5 py-3.5 text-right">
                  <Button href={`/admin/bairros/${b.id}`} variant="secondary" size="sm">
                    Editar
                  </Button>
                </td>
              )}
            </tr>
          ))
        }
        {
          bairros.length === 0 && (
            <tr>
              <td colspan={podeEditar ? 3 : 2} class="px-5 py-10 text-center text-ink-muted">
                Nenhum bairro cadastrado ainda.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</AdminLayout>
