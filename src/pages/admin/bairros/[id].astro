---
import { env } from 'cloudflare:workers'
import Button from '../../../components/ui/Button.astro'
import Input from '../../../components/ui/Input.astro'
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { createDb } from '../../../server/db/client'
import {
  countPropertiesInNeighborhood,
  findNeighborhoodById,
} from '../../../server/db/queries/neighborhoods'
import { editarBairro, removerBairro } from '../../../server/services/neighborhoods'
import { parseBairro } from '../../../server/validation/neighborhood'

// O middleware já restringe /admin/bairros/<id> a administrador.
const id = Number(Astro.params.id)
const db = createDb(env.DB)
const bairro = Number.isInteger(id) ? await findNeighborhoodById(db, id) : null

if (!bairro) {
  return Astro.redirect('/admin/bairros', 302)
}

let erro: string | null = null
let campo: string | null = null
let valor = bairro.name

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()

  if (form.get('acao') === 'remover') {
    const resultado = await removerBairro(db, bairro.id)
    if (resultado.ok) {
      return Astro.redirect(`/admin/bairros?removido=${encodeURIComponent(bairro.name)}`, 303)
    }
    erro = resultado.erro
  } else {
    valor = String(form.get('name') ?? '')
    const parsed = parseBairro(form)
    if (parsed.success) {
      const resultado = await editarBairro(db, bairro.id, parsed.data.name)
      if (resultado.ok) {
        return Astro.redirect(`/admin/bairros?salvo=${encodeURIComponent(resultado.bairro.name)}`, 303)
      }
      erro = resultado.erro
    } else {
      campo = parsed.error.issues[0]?.message ?? 'Confira o nome informado.'
    }
  }
}

const emUso = await countPropertiesInNeighborhood(db, bairro.id)
---

<AdminLayout title={bairro.name}>
  <header class="mb-8">
    <a href="/admin/bairros" class="text-sm text-ink-muted hover:text-ink">← Bairros</a>
    <h1 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">{bairro.name}</h1>
    <p class="mt-1 text-sm text-ink-muted">
      {emUso === 0 ? 'Nenhum imóvel usa este bairro.' : null}
      {emUso === 1 ? '1 imóvel usa este bairro.' : null}
      {emUso > 1 ? `${emUso} imóveis usam este bairro.` : null}
    </p>
  </header>

  {
    erro && (
      <p role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {erro}
      </p>
    )
  }

  <section class="max-w-lg rounded-xl border border-brand-100 bg-white p-6 shadow-sm">
    <h2 class="font-display text-lg font-semibold text-ink">Renomear</h2>
    <p class="mt-1 text-sm text-ink-muted">
      O nome novo passa a valer em todos os imóveis deste bairro de uma vez, no site e no painel.
    </p>

    <form method="post" class="mt-5 flex flex-col gap-5">
      <Input name="name" label="Nome" required value={valor} error={campo ?? undefined} />
      <div class="flex flex-wrap items-center gap-3 border-t border-brand-100 pt-5">
        <Button type="submit">Salvar</Button>
        <Button href="/admin/bairros" variant="ghost">Cancelar</Button>
      </div>
    </form>
  </section>

  <section class="mt-8 max-w-lg rounded-xl border border-red-200 bg-red-50/50 p-6">
    <h2 class="font-display text-lg font-semibold text-ink">Remover</h2>
    <p class="mt-1 text-sm text-ink-soft">
      {
        emUso > 0
          ? 'Não dá para remover enquanto houver imóvel usando este bairro. Troque o bairro deles primeiro.'
          : 'Este bairro não está em uso e pode ser removido.'
      }
    </p>

    {
      emUso === 0 && (
        /* <details> como confirmação: funciona sem JavaScript, igual ao resto do painel. */
        <details class="mt-4">
          <summary class="inline-flex cursor-pointer items-center rounded-lg border border-red-300 px-3.5 py-2 text-sm font-medium text-red-700 hover:bg-red-100">
            Remover bairro
          </summary>
          <form method="post" class="mt-3 flex items-center gap-3">
            <input type="hidden" name="acao" value="remover" />
            <p class="text-sm text-ink-soft">Tem certeza? Não dá para desfazer.</p>
            <Button type="submit" variant="danger" size="sm">Confirmar</Button>
          </form>
        </details>
      )
    }
  </section>
</AdminLayout>
