---
import { env } from 'cloudflare:workers'
import Pagination from '../../../components/site/Pagination.astro'
import Badge from '../../../components/ui/Badge.astro'
import Button from '../../../components/ui/Button.astro'
import ConfirmAction from '../../../components/ui/ConfirmAction.astro'
import Icon from '../../../components/ui/Icon.astro'
import AdminLayout from '../../../layouts/AdminLayout.astro'
import { formatBRL, PROPERTY_TYPE_LABELS } from '../../../lib/format'
import { createDb } from '../../../server/db/client'
import { searchAdminProperties, setPropertyStatus } from '../../../server/db/queries/properties'

const db = createDb(env.DB)

// Alternar situação é POST daqui mesmo, e responde com redirect para o
// refresh do navegador não reenviar o formulário.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const id = Number(form.get('id'))
  const status = String(form.get('status'))

  if (Number.isInteger(id) && (status === 'active' || status === 'inactive')) {
    await setPropertyStatus(db, id, status)
  }
  return Astro.redirect(`/admin/imoveis${Astro.url.search}`, 303)
}

const q = Astro.url.searchParams.get('q')?.trim() || undefined
const statusFiltro = Astro.url.searchParams.get('situacao')
const status = statusFiltro === 'active' || statusFiltro === 'inactive' ? statusFiltro : undefined
const page = Number(Astro.url.searchParams.get('pagina')) || 1
const criado = Astro.url.searchParams.get('criado')
const salvo = Astro.url.searchParams.get('salvo')

const { items, total, totalPages } = await searchAdminProperties(db, { q, status, page })
---

<AdminLayout title="Imóveis">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink sm:text-3xl">Imóveis</h1>
      <p class="mt-1 text-sm text-ink-muted">{total} {total === 1 ? 'registro' : 'registros'}</p>
    </div>
    <Button href="/admin/imoveis/novo">
      <Icon name="check" size={16} />
      Cadastrar imóvel
    </Button>
  </header>

  {
    (criado || salvo) && (
      <p role="status" class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
        {criado ? `Imóvel ${criado} cadastrado.` : `Imóvel ${salvo} salvo.`}
      </p>
    )
  }

  <form method="get" class="mb-6 flex flex-wrap gap-3">
    <input
      type="search"
      name="q"
      value={q ?? ''}
      placeholder="Buscar por título, código ou bairro"
      class="h-10 min-w-56 flex-1 rounded-lg border border-brand-200 bg-white px-3.5 text-sm text-ink placeholder:text-ink-muted/60 focus:outline-none"
    />
    <select
      name="situacao"
      class="h-10 rounded-lg border border-brand-200 bg-white px-3 text-sm text-ink focus:outline-none"
    >
      <option value="">Todas as situações</option>
      <option value="active" selected={status === 'active'}>Ativos</option>
      <option value="inactive" selected={status === 'inactive'}>Inativos</option>
    </select>
    <button type="submit" class="h-10 rounded-lg bg-brand-900 px-4 text-sm font-medium text-white hover:bg-brand-800">
      Filtrar
    </button>
  </form>

  {
    items.length === 0 ? (
      <div class="rounded-xl border border-dashed border-brand-200 bg-white px-6 py-16 text-center">
        <p class="font-display text-lg font-semibold text-ink">Nenhum imóvel encontrado</p>
        <p class="mt-1 text-sm text-ink-muted">Ajuste a busca ou cadastre o primeiro imóvel.</p>
      </div>
    ) : (
      <div class="overflow-x-auto rounded-xl border border-brand-100 bg-white">
        <table class="w-full min-w-[46rem] text-sm">
          <thead>
            <tr class="border-b border-brand-100 text-left text-xs tracking-wide text-ink-muted uppercase">
              <th class="px-4 py-3 font-medium">Código</th>
              <th class="px-4 py-3 font-medium">Imóvel</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Preço</th>
              <th class="px-4 py-3 font-medium">Situação</th>
              <th class="px-4 py-3" />
            </tr>
          </thead>
          <tbody>
            {items.map((imovel) => (
              <tr class="border-b border-brand-100 last:border-0">
                <td class="px-4 py-3 font-mono text-xs text-ink-muted">{imovel.code}</td>
                <td class="px-4 py-3">
                  <a href={`/admin/imoveis/${imovel.id}`} class="font-medium text-ink hover:underline">
                    {imovel.title}
                  </a>
                  <p class="text-xs text-ink-muted">{imovel.addressNeighborhood ?? '—'}</p>
                </td>
                <td class="px-4 py-3 text-ink-soft">{PROPERTY_TYPE_LABELS[imovel.type]}</td>
                <td class="px-4 py-3 tabular-nums text-ink-soft">{formatBRL(imovel.price)}</td>
                <td class="px-4 py-3">
                  {imovel.status === 'active' ? (
                    <Badge variant="gold">Ativo</Badge>
                  ) : (
                    <Badge variant="muted">Inativo</Badge>
                  )}
                </td>
                <td class="px-4 py-3">
                  <div class="flex justify-end gap-2">
                    <Button href={`/admin/imoveis/${imovel.id}`} variant="secondary" size="sm">
                      Editar
                    </Button>
                    {imovel.status === 'active' ? (
                      <ConfirmAction
                        action={`/admin/imoveis${Astro.url.search}`}
                        label="Inativar"
                        question={`Tirar ${imovel.code} do site? O registro continua aqui e pode voltar quando quiser.`}
                        confirmLabel="Inativar"
                        tone="danger"
                      >
                        <input type="hidden" name="id" value={imovel.id} />
                        <input type="hidden" name="status" value="inactive" />
                      </ConfirmAction>
                    ) : (
                      <form method="post" action={`/admin/imoveis${Astro.url.search}`}>
                        <input type="hidden" name="id" value={imovel.id} />
                        <input type="hidden" name="status" value="active" />
                        <button
                          type="submit"
                          class="h-9 rounded-lg border border-brand-200 px-3 text-sm text-ink-soft hover:bg-brand-50"
                        >
                          Reativar
                        </button>
                      </form>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <div class="mt-8">
    <Pagination url={Astro.url} page={page} totalPages={totalPages} />
  </div>
</AdminLayout>
