---
import Button from '../components/ui/Button.astro'
import Container from '../components/ui/Container.astro'
import Icon from '../components/ui/Icon.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { site } from '../lib/site'
---

<SiteLayout title={`Página não encontrada — ${site.name}`}>
  <Container class="flex flex-col items-center gap-4 py-24 text-center sm:py-32">
    <p class="font-display text-6xl font-bold text-brand-200">404</p>
    <h1 class="font-display text-3xl font-bold text-ink">Página não encontrada</h1>
    <p class="max-w-md text-ink-soft">
      O endereço que você tentou acessar não existe ou foi movido.
    </p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      <Button href="/imoveis">Ver imóveis</Button>
      <Button href="/" variant="secondary">Ir para a página inicial</Button>
      <Button href={site.whatsapp.link()} variant="whatsapp" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} />
        Falar no WhatsApp
      </Button>
    </div>
  </Container>
</SiteLayout>
