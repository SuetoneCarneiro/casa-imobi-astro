---
import Button from '../components/ui/Button.astro'
import Container from '../components/ui/Container.astro'
import Icon from '../components/ui/Icon.astro'
import Section from '../components/ui/Section.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { site } from '../lib/site'

const mensagem = 'Olá! Tenho um imóvel que gostaria de anunciar com a CasaImobi.'

const etapas = [
  {
    titulo: 'Você nos conta sobre o imóvel',
    texto: 'Endereço, tamanho, número de quartos e o valor que tem em mente. Pode ser pelo WhatsApp mesmo.',
  },
  {
    titulo: 'Fazemos a avaliação',
    texto: 'Visitamos o imóvel, tiramos as fotos e sugerimos um valor compatível com o mercado da região.',
  },
  {
    titulo: 'Conferimos a documentação',
    texto: 'Orientamos sobre o que precisa estar em ordem antes de colocar o imóvel à venda.',
  },
  {
    titulo: 'Divulgamos e acompanhamos',
    texto: 'O imóvel entra no site e nos nossos canais. Filtramos os interessados e acompanhamos até a escritura.',
  },
]
---

<SiteLayout
  title={`Anuncie seu imóvel — ${site.name}`}
  description="Avaliação, fotos, documentação e divulgação do seu imóvel em Caruaru e região."
>
  <section class="border-b border-brand-100 bg-gradient-to-b from-brand-50 to-surface">
    <Container class="py-14 sm:py-20">
      <h1 class="max-w-3xl font-display text-4xl font-bold text-balance text-ink sm:text-5xl">
        Seu imóvel anunciado por quem conhece o mercado daqui.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        Cuidamos da avaliação, das fotos, da documentação e da divulgação. Você não precisa atender
        curioso nem marcar visita.
      </p>
      <Button
        href={site.whatsapp.link(mensagem)}
        variant="whatsapp"
        size="lg"
        class="mt-8"
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={19} />
        Quero anunciar meu imóvel
      </Button>
    </Container>
  </section>

  <Section eyebrow="Como funciona" title="Da conversa até a escritura" tone="white">
    <ol class="grid gap-6 sm:grid-cols-2">
      {
        etapas.map((etapa, i) => (
          <li class="flex gap-4 rounded-xl border border-brand-100 p-6">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-900 font-display font-semibold text-white">
              {i + 1}
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold text-ink">{etapa.titulo}</h3>
              <p class="mt-1 text-[15px] text-ink-soft">{etapa.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <section class="bg-brand-900 text-white">
    <Container class="flex flex-col items-start gap-6 py-14 sm:py-20 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <h2 class="font-display text-3xl font-semibold text-balance sm:text-4xl">
          Vamos avaliar seu imóvel?
        </h2>
        <p class="mt-3 text-white/75">A conversa inicial não tem compromisso nem custo.</p>
      </div>
      <Button
        href={site.whatsapp.link(mensagem)}
        variant="whatsapp"
        size="lg"
        target="_blank"
        rel="noopener"
      >
        <Icon name="whatsapp" size={19} />
        Falar no WhatsApp
      </Button>
    </Container>
  </section>
</SiteLayout>
