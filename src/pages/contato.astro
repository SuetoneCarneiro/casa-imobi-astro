---
import Button from '../components/ui/Button.astro'
import Container from '../components/ui/Container.astro'
import Icon from '../components/ui/Icon.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { site } from '../lib/site'

const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address.full)}`

const canais = [
  {
    icon: 'whatsapp',
    titulo: 'WhatsApp',
    texto: 'O caminho mais rápido. Respondemos no horário comercial.',
    acao: { label: 'Abrir conversa', href: site.whatsapp.link(), externo: true },
  },
  {
    icon: 'phone',
    titulo: 'Telefone',
    texto: site.phones.map((p) => p.label).join(' · '),
    acao: { label: 'Ligar agora', href: site.phones[0].href, externo: false },
  },
  {
    icon: 'mail',
    titulo: 'E-mail',
    texto: site.email,
    acao: { label: 'Enviar e-mail', href: `mailto:${site.email}`, externo: false },
  },
] as const

const redes = [
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
] as const
---

<SiteLayout
  title={`Contato — ${site.name}`}
  description={`Fale com a ${site.name} em Caruaru/PE pelo WhatsApp, telefone ou e-mail.`}
>
  <section class="border-b border-brand-100 bg-gradient-to-b from-brand-50 to-surface">
    <Container class="py-14 sm:py-20">
      <h1 class="font-display text-4xl font-bold text-balance text-ink sm:text-5xl">Contato</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        Sem formulário. Escolha o canal que preferir e fale direto com a gente.
      </p>
    </Container>
  </section>

  <Container class="py-12 sm:py-16">
    <div class="grid gap-6 sm:grid-cols-3">
      {
        canais.map((canal) => (
          <div class="flex flex-col gap-3 rounded-xl border border-brand-100 bg-white p-6">
            <Icon name={canal.icon} size={26} class="text-brand-600" />
            <h2 class="font-display text-lg font-semibold text-ink">{canal.titulo}</h2>
            <p class="flex-1 text-sm break-words text-ink-soft">{canal.texto}</p>
            <Button
              href={canal.acao.href}
              variant={canal.icon === 'whatsapp' ? 'whatsapp' : 'secondary'}
              size="sm"
              class="w-fit"
              target={canal.acao.externo ? '_blank' : undefined}
              rel={canal.acao.externo ? 'noopener' : undefined}
            >
              {canal.acao.label}
            </Button>
          </div>
        ))
      }
    </div>

    <div class="mt-12 grid gap-8 rounded-xl border border-brand-100 bg-white p-6 sm:grid-cols-2 sm:p-8">
      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Nosso endereço</h2>
        <p class="mt-3 flex gap-2 text-ink-soft">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-brand-600" />
          <span>
            {site.address.street}<br />
            {site.address.reference}<br />
            {site.address.neighborhood}, {site.address.city}/{site.address.state}<br />
            CEP {site.address.zip}
          </span>
        </p>
        <Button href={mapa} variant="secondary" size="sm" class="mt-4 w-fit" target="_blank" rel="noopener">
          Ver no mapa
          <Icon name="arrow-right" size={16} />
        </Button>
      </div>

      <div>
        <h2 class="font-display text-xl font-semibold text-ink">Redes sociais</h2>
        <ul class="mt-3 flex gap-2">
          {
            redes.map((rede) => (
              <li>
                <a
                  href={rede.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={rede.label}
                  class="flex size-11 items-center justify-center rounded-lg border border-brand-100 text-brand-700 transition-colors hover:bg-brand-50"
                >
                  <Icon name={rede.name} size={20} />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm text-ink-muted">CRECI {site.creci}</p>
      </div>
    </div>
  </Container>
</SiteLayout>
