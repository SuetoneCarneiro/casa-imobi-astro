---
import { env } from 'cloudflare:workers'
import Layout from '../layouts/Layout.astro'
import { formatBRL } from '../lib/format'
import { createDb } from '../server/db/client'
import { countActiveProperties, listActiveProperties } from '../server/db/queries/properties'

// Leitura direta do D1 no SSR — sem passar pela API.
const db = createDb(env.DB)
const total = await countActiveProperties(db)
const imoveis = await listActiveProperties(db, 5)
---

<Layout>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-8 px-6 py-16">
    <img
      src="/logo-casaimobi-web.png"
      alt="CasaImobi — Negócios Imobiliários"
      width="1000"
      height="608"
      class="w-[200px]"
    />

    <div class="space-y-3">
      <p class="text-sm font-medium tracking-widest text-gold-700 uppercase">Fase 1</p>
      <h1 class="text-3xl font-bold text-balance text-brand-900">Banco no ar</h1>
      <p class="text-brand-800">
        Quatro tabelas no D1, migration aplicada e seed carregado.
        <strong>{total}</strong> imóveis ativos, lidos direto do banco pelo SSR.
      </p>
    </div>

    <ul class="divide-y divide-brand-100 rounded-lg border border-brand-100 bg-white">
      {
        imoveis.map((imovel) => (
          <li class="flex items-baseline justify-between gap-4 px-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-brand-900">{imovel.title}</p>
              <p class="text-xs text-brand-700/70">
                {imovel.code} · {imovel.addressNeighborhood}
              </p>
            </div>
            <span class="shrink-0 text-sm font-semibold tabular-nums text-brand-900">
              {formatBRL(imovel.price)}
            </span>
          </li>
        ))
      }
    </ul>

    <a
      href="/api/health"
      class="inline-flex w-fit rounded-lg bg-brand-900 px-5 py-2.5 font-medium text-white transition hover:bg-brand-800 focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Testar /api/health
    </a>
  </main>
</Layout>
