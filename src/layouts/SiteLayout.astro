---
import Footer from '../components/site/Footer.astro'
import Header from '../components/site/Header.astro'
import WhatsAppFloat from '../components/site/WhatsAppFloat.astro'
import Layout from './Layout.astro'

interface Props {
  title?: string
  description?: string
  whatsappMessage?: string
}

const { whatsappMessage, ...meta } = Astro.props
---

<Layout {...meta}>
  <div class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-brand-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat message={whatsappMessage} />
  </div>
</Layout>
