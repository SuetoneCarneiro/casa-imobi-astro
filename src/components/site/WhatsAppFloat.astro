---
import { site } from '../../lib/site'
import Icon from '../ui/Icon.astro'

interface Props {
  message?: string
}

const { message } = Astro.props
---

<a
  href={site.whatsapp.link(message)}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg transition-transform hover:scale-105 sm:right-6 sm:bottom-6"
  aria-label="Falar com a CasaImobi no WhatsApp"
>
  <Icon name="whatsapp" size={28} />
</a>
