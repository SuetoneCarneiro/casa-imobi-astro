---
import Icon, { type IconName } from '../ui/Icon.astro'

interface Props {
  icon?: IconName
  title: string
  description?: string
}

const { icon = 'search', title, description } = Astro.props
---

<div
  class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-brand-200 bg-white px-6 py-16 text-center"
>
  <Icon name={icon} size={32} class="text-brand-300" />
  <p class="font-display text-lg font-semibold text-ink">{title}</p>
  {description && <p class="max-w-md text-sm text-ink-muted">{description}</p>}
  <slot />
</div>
