---
import type { Property } from '../../server/db/schema'
import Button from '../ui/Button.astro'
import Icon, { type IconName } from '../ui/Icon.astro'
import PropertyCard from './PropertyCard.astro'

interface Props {
  title: string
  icon: IconName
  properties: Property[]
  /** Total de ativos na categoria, para o rótulo do botão. */
  total: number
  /** Destino do "Ver todos", já filtrado. */
  href: string
  /** Primeira dobra carrega sem lazy. */
  priority?: boolean
}

const { title, icon, properties, total, href, priority = false } = Astro.props
---

<section class="flex flex-col gap-6">
  <header class="flex items-end justify-between gap-4">
    <div class="flex items-center gap-3">
      <Icon name={icon} size={26} class="text-brand-600" />
      <h3 class="font-display text-2xl font-semibold text-ink sm:text-3xl">{title}</h3>
      <span class="text-sm tabular-nums text-ink-muted">
        {total} {total === 1 ? 'imóvel' : 'imóveis'}
      </span>
    </div>

    <!--
      Setas nascem com `hidden` e só aparecem se o script rodar. Sem JavaScript
      o carrossel continua inteiro: arrasta no toque, rola no trackpad e navega
      por teclado, porque é scroll nativo com scroll-snap.
    -->
    <div class="hidden gap-2 sm:flex" data-controls>
      <button
        type="button"
        data-scroll="prev"
        hidden
        aria-label={`Ver ${title.toLowerCase()} anteriores`}
        class="flex size-10 items-center justify-center rounded-lg border border-brand-200 text-ink-soft transition-colors hover:bg-brand-50 disabled:cursor-default disabled:opacity-35 disabled:hover:bg-transparent"
      >
        <Icon name="arrow-right" size={18} class="rotate-180" />
      </button>
      <button
        type="button"
        data-scroll="next"
        hidden
        aria-label={`Ver mais ${title.toLowerCase()}`}
        class="flex size-10 items-center justify-center rounded-lg border border-brand-200 text-ink-soft transition-colors hover:bg-brand-50 disabled:cursor-default disabled:opacity-35 disabled:hover:bg-transparent"
      >
        <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </header>

  <div data-carousel>
    <ul
      data-track
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        properties.map((property, i) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <PropertyCard property={property} priority={priority && i < 3} />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex justify-center">
    <Button href={href} variant="secondary">
      Ver {total === 1 ? 'o imóvel' : `todos os ${total}`}
      <Icon name="arrow-right" size={16} />
    </Button>
  </div>
</section>

<script>
  // Melhoria progressiva: liga as setas só quando há JavaScript.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-track]')
    const controls = carousel.parentElement?.querySelector<HTMLElement>('[data-controls]')
    if (!track || !controls) return

    const buttons = controls.querySelectorAll<HTMLButtonElement>('[data-scroll]')

    /**
     * Esconde as setas quando não há o que rolar e desabilita a que já chegou
     * ao fim. Roda via ResizeObserver porque medir uma vez no carregamento dá
     * resultado errado: as fontes ainda não assentaram o layout, e o usuário
     * pode redimensionar a janela depois.
     */
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth
      const rolavel = max > 8
      buttons.forEach((button) => {
        button.hidden = !rolavel
        button.disabled =
          button.dataset.scroll === 'next' ? track.scrollLeft >= max - 8 : track.scrollLeft <= 8
      })
    }

    // A animação fica só aqui. `scroll-behavior: smooth` no CSS interferia no
    // scroll programático e também suavizava o arrasto do usuário, que deve
    // ser direto.
    const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)')

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.dataset.scroll === 'next' ? 1 : -1
        track.scrollBy({
          left: direction * track.clientWidth * 0.9,
          behavior: reduzMovimento.matches ? 'auto' : 'smooth',
        })
      })
    })

    track.addEventListener('scroll', sync, { passive: true })

    /**
     * Medir uma vez só dá resultado errado: quando o script roda, o CSS pode
     * ainda não ter aplicado a largura dos cards, e as fontes mudam o layout
     * depois. Então o sync é reexecutado em cada momento em que a medida pode
     * ter mudado.
     */
    const observer = new ResizeObserver(sync)
    observer.observe(track)
    if (track.firstElementChild) observer.observe(track.firstElementChild)

    window.addEventListener('load', sync)
    document.fonts?.ready.then(sync)
  })
</script>
