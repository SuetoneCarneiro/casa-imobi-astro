---
import type { Property } from '../../server/db/schema'
import { imageUrl } from '../../server/services/images'
import Button from '../ui/Button.astro'
import Icon, { type IconName } from '../ui/Icon.astro'
import PropertyCard from './PropertyCard.astro'

interface Props {
  title: string
  icon: IconName
  properties: Property[]
  /** Capas já resolvidas pela página, para não consultar por cartão. */
  covers?: Map<number, { storageKey: string; format: 'webp' | 'jpg' | 'png' }>
  /** Total de ativos na categoria, para o rótulo do botão. */
  total: number
  /** Destino do "Ver todos", já filtrado. */
  href: string
  /** Primeira dobra carrega sem lazy. */
  priority?: boolean
}

const { title, icon, properties, covers, total, href, priority = false } = Astro.props
---

<section class="flex flex-col gap-6" data-carousel-root>
  <header class="flex items-end justify-between gap-4">
    <div class="flex items-center gap-3">
      <Icon name={icon} size={26} class="text-brand-600" />
      <h3 class="font-display text-2xl font-semibold text-ink sm:text-3xl">{title}</h3>
      <span class="text-sm tabular-nums text-ink-muted">
        {total} {total === 1 ? 'imóvel' : 'imóveis'}
      </span>
    </div>

    <!--
      Setas nascem com `hidden` e só aparecem se o script rodar. Sem JavaScript
      o carrossel continua inteiro: arrasta no toque, rola no trackpad e navega
      por teclado, porque é scroll nativo com scroll-snap.
    -->
    <div class="hidden gap-2 sm:flex" data-controls>
      <button
        type="button"
        data-scroll="prev"
        hidden
        aria-label={`Ver ${title.toLowerCase()} anteriores`}
        class="flex size-10 items-center justify-center rounded-lg border border-brand-200 text-ink-soft transition-colors hover:bg-brand-50 data-[edge=true]:opacity-35 data-[edge=true]:hover:bg-transparent"
      >
        <Icon name="arrow-right" size={18} class="rotate-180" />
      </button>
      <button
        type="button"
        data-scroll="next"
        hidden
        aria-label={`Ver mais ${title.toLowerCase()}`}
        class="flex size-10 items-center justify-center rounded-lg border border-brand-200 text-ink-soft transition-colors hover:bg-brand-50 data-[edge=true]:opacity-35 data-[edge=true]:hover:bg-transparent"
      >
        <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </header>

  <div>
    <ul
      data-track
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        properties.map((property, i) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <PropertyCard
              property={property}
              coverUrl={covers?.get(property.id) ? imageUrl(covers.get(property.id)!.storageKey, 'thumb', covers.get(property.id)!.format) : null}
              priority={priority && i < 3}
            />
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex justify-center">
    <Button href={href} variant="secondary">
      Ver {total === 1 ? 'o imóvel' : `todos os ${total}`}
      <Icon name="arrow-right" size={16} />
    </Button>
  </div>
</section>

<script>
  import '../../scripts/carousel'
</script>
