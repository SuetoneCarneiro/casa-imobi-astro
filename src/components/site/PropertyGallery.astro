---
import type { PropertyImage, Property } from '../../server/db/schema'
import { imageUrl } from '../../server/services/images'
import { PROPERTY_TYPE_ICONS } from '../../lib/format'
import Icon from '../ui/Icon.astro'

interface Props {
  images: PropertyImage[]
  property: Property
}

const { images, property } = Astro.props
---

{
  images.length === 0 ? (
    <div class="flex aspect-[16/9] w-full flex-col items-center justify-center gap-2 rounded-xl border border-brand-100 bg-brand-50 text-brand-600">
      <Icon name={PROPERTY_TYPE_ICONS[property.type]} size={56} />
      <span class="text-sm font-medium">Fotos em breve</span>
    </div>
  ) : (
    <>
    <figure class="flex flex-col gap-3" data-carousel-root>
      <div class="relative">
        {/* Base sem JavaScript: scroll nativo com encaixe, que já serve o toque. */}
        <ul
          data-track
          class="flex snap-x snap-mandatory gap-3 overflow-x-auto rounded-xl [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {images.map((foto, i) => (
            <li class="w-full shrink-0 snap-start">
              {/*
                Link de verdade para a versão grande: sem JavaScript o navegador
                abre a imagem, que já é uma forma de ver em tela cheia. Com
                JavaScript o clique vira o modal.
              */}
              <a
                href={imageUrl(foto.storageKey, 'full', foto.format)}
                data-lightbox
                aria-label={`Ampliar foto ${i + 1} de ${images.length}`}
                class="group block cursor-zoom-in rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
              >
                <img
                  src={imageUrl(foto.storageKey, 'md', foto.format)}
                  alt={foto.alt ?? `${property.title} — foto ${i + 1}`}
                  width={foto.width ?? 1024}
                  height={foto.height ?? 768}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-[16/9] w-full rounded-xl bg-brand-50 object-cover"
                />
              </a>
            </li>
          ))}
        </ul>

        {/*
          As setas existem porque no desktop com mouse não há gesto de arrastar.
          Nascem com `hidden` e só aparecem se o JavaScript rodar.
        */}
        {images.length > 1 && (
          <>
            <button
              type="button"
              data-scroll="prev"
              hidden
              aria-label="Foto anterior"
              class="absolute top-1/2 left-3 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white data-[edge=true]:opacity-40"
            >
              <Icon name="arrow-right" size={20} class="rotate-180" />
            </button>
            <button
              type="button"
              data-scroll="next"
              hidden
              aria-label="Próxima foto"
              class="absolute top-1/2 right-3 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg backdrop-blur transition hover:bg-white data-[edge=true]:opacity-40"
            >
              <Icon name="arrow-right" size={20} />
            </button>
          </>
        )}
      </div>

      {images.length > 1 && (
        <figcaption class="text-center text-xs text-ink-muted">
          {images.length} fotos. Use as setas ou arraste para o lado. Clique para ampliar.
        </figcaption>
      )}
    </figure>

      {/*
        Fica fora do <figure> porque, aberto, o <dialog> modal sobe para a
        camada superior da página e deixa de pertencer ao fluxo daqui.

        `hidden open:flex`, e não `flex` puro: o navegador esconde um <dialog>
        fechado com `dialog:not([open]) { display: none }`, mas essa regra é da
        folha dele, e qualquer `display` vindo do autor vence, independente de
        especificidade. Com `flex` fixo o diálogo ocupava a página desde o
        carregamento, e a foto reaparecia no meio do conteúdo ao fechar.
      */}
      <dialog
        data-lightbox-dialog
        aria-label="Foto em tela cheia"
        class="m-0 hidden h-[100dvh] max-h-[100dvh] w-screen max-w-none items-center justify-center border-0 bg-transparent p-0 backdrop:bg-black/90 open:flex"
      >
        <img data-lightbox-img alt="" class="max-h-[88dvh] max-w-[94vw] object-contain" />

        {/*
          Fundo escuro com anel claro, e não um véu branco: no celular os
          botões ficam por cima da própria foto, e sobre uma imagem clara um
          branco translúcido simplesmente some.
        */}

        <button
          type="button"
          data-lightbox-close
          aria-label="Fechar"
          class="absolute top-4 right-4 flex size-11 items-center justify-center rounded-full bg-black/55 text-white ring-1 ring-white/25 backdrop-blur transition hover:bg-black/80"
        >
          <Icon name="close" size={22} />
        </button>

        {images.length > 1 && (
          <>
            <button
              type="button"
              data-lightbox-prev
              aria-label="Foto anterior"
              class="absolute top-1/2 left-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-white ring-1 ring-white/25 backdrop-blur transition hover:bg-black/80 sm:left-6"
            >
              <Icon name="arrow-right" size={24} class="rotate-180" />
            </button>
            <button
              type="button"
              data-lightbox-next
              aria-label="Próxima foto"
              class="absolute top-1/2 right-3 flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-white ring-1 ring-white/25 backdrop-blur transition hover:bg-black/80 sm:right-6"
            >
              <Icon name="arrow-right" size={24} />
            </button>

            {/* aria-live avisa o leitor de tela a cada troca, que não recarrega a página. */}
            <p
              data-lightbox-counter
              aria-live="polite"
              class="absolute bottom-5 left-1/2 -translate-x-1/2 rounded-full bg-black/70 px-3.5 py-1.5 text-sm text-white"
            />
          </>
        )}
      </dialog>
    </>
  )
}

<script>
  import '../../scripts/carousel'
  import '../../scripts/lightbox'
</script>
