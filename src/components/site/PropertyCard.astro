---
import { formatArea, formatBRL, PROPERTY_TYPE_ICONS, PROPERTY_TYPE_LABELS } from '../../lib/format'
import type { Property } from '../../server/db/schema'
import Badge from '../ui/Badge.astro'
import Icon from '../ui/Icon.astro'

interface Props {
  property: Property
  /** URL da foto de capa. Ausente = imóvel ainda sem foto (estado real, não erro). */
  coverUrl?: string | null
  /** A primeira dobra não deve usar lazy. */
  priority?: boolean
}

const { property, coverUrl = null, priority = false } = Astro.props

const specs = [
  { icon: 'bed' as const, value: property.bedrooms, label: property.bedrooms === 1 ? 'quarto' : 'quartos' },
  { icon: 'bath' as const, value: property.bathrooms, label: property.bathrooms === 1 ? 'banheiro' : 'banheiros' },
  { icon: 'car' as const, value: property.parkingSpaces, label: property.parkingSpaces === 1 ? 'vaga' : 'vagas' },
].filter((s) => s.value > 0)

const area = formatArea(property.usableArea)
const href = `/imoveis/${property.slug}`
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-brand-100 bg-white transition-shadow hover:shadow-lg"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-50">
    {
      coverUrl ? (
        <img
          src={coverUrl}
          alt={property.title}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="flex size-full flex-col items-center justify-center gap-2 text-brand-300">
          <Icon name={PROPERTY_TYPE_ICONS[property.type]} size={40} />
          <span class="text-xs font-medium">Sem foto</span>
        </div>
      )
    }

    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      <Badge>{PROPERTY_TYPE_LABELS[property.type]}</Badge>
      {property.isCondo && <Badge variant="gold">Condomínio</Badge>}
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div>
      <h3 class="font-display text-lg leading-snug font-semibold text-ink">
        <a href={href} class="after:absolute after:inset-0 focus:outline-none">
          {property.title}
        </a>
      </h3>
      {
        property.addressNeighborhood && (
          <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-muted">
            <Icon name="pin" size={14} />
            {property.addressNeighborhood}, {property.addressCity}
          </p>
        )
      }
    </div>

    {
      (specs.length > 0 || area) && (
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-ink">
          {specs.map((spec) => (
            <li class="flex items-center gap-1.5">
              <Icon name={spec.icon} size={17} class="text-brand-600" />
              <span class="tabular-nums">{spec.value}</span>
              <span class="text-ink-muted">{spec.label}</span>
            </li>
          ))}
          {area && (
            <li class="flex items-center gap-1.5">
              <Icon name="area" size={17} class="text-brand-600" />
              <span class="tabular-nums">{area}</span>
            </li>
          )}
        </ul>
      )
    }

    <div class="mt-auto flex items-baseline justify-between gap-3 pt-2">
      <p class="font-display text-xl font-bold tracking-tight tabular-nums text-ink">
        {formatBRL(property.price)}
      </p>
      <span class="font-mono text-xs text-ink-muted">{property.code}</span>
    </div>
  </div>
</article>

<style>
  article {
    position: relative;
  }
</style>
