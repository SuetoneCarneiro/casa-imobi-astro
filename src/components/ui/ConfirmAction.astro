---
/**
 * Confirmação sem JavaScript: <details> revela o painel com o botão real.
 * Clicar fora não fecha, mas o Esc fecha e o teclado navega normalmente.
 */
interface Props {
  action: string
  label: string
  question: string
  confirmLabel: string
  tone?: 'default' | 'danger'
  class?: string
}

const { action, label, question, confirmLabel, tone = 'default', class: className = '' } = Astro.props

const confirmClasses =
  tone === 'danger'
    ? 'bg-red-600 text-white hover:bg-red-700'
    : 'bg-brand-900 text-white hover:bg-brand-800'
---

<details class={`group relative inline-block ${className}`}>
  <summary
    class="flex h-9 cursor-pointer list-none items-center rounded-lg border border-brand-200 px-3 text-sm text-ink-soft transition-colors hover:bg-brand-50 [&::-webkit-details-marker]:hidden"
  >
    {label}
  </summary>

  <div
    class="absolute right-0 z-20 mt-2 w-64 rounded-xl border border-brand-100 bg-white p-4 text-left shadow-lg"
  >
    <p class="text-sm text-ink-soft">{question}</p>
    <form method="post" action={action} class="mt-3 flex justify-end gap-2">
      <slot />
      <button
        type="submit"
        class={`h-9 rounded-lg px-3 text-sm font-medium transition-colors ${confirmClasses}`}
      >
        {confirmLabel}
      </button>
    </form>
  </div>
</details>
