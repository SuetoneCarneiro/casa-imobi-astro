---
interface Props {
  size?: 'default' | 'narrow' | 'wide'
  class?: string
}

const { size = 'default', class: className = '' } = Astro.props

const sizes = {
  narrow: 'max-w-3xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
}
---

<div class={`mx-auto w-full ${sizes[size]} px-5 sm:px-6 lg:px-8 ${className}`}>
  <slot />
</div>
