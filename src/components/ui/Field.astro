---
/**
 * Moldura comum de Input, Select e Textarea: rótulo, dica e erro.
 * Mantém alinhamento e espaçamento idênticos entre os três.
 */
interface Props {
  id: string
  label: string
  hint?: string
  error?: string
  required?: boolean
  class?: string
}

const { id, label, hint, error, required = false, class: className = '' } = Astro.props
---

<div class={`flex flex-col gap-1.5 ${className}`}>
  <label for={id} class="text-sm font-medium text-ink">
    {label}
    {required && <span class="text-gold-700" aria-hidden="true">*</span>}
  </label>

  <slot />

  {hint && !error && <p id={`${id}-hint`} class="text-xs text-ink-muted">{hint}</p>}
  {error && <p id={`${id}-error`} class="text-xs font-medium text-red-700">{error}</p>}
</div>
