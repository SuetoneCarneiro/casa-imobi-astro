---
import Container from './Container.astro'

interface Props {
  eyebrow?: string
  title?: string
  description?: string
  tone?: 'surface' | 'white' | 'brand'
  align?: 'left' | 'center'
  class?: string
}

const {
  eyebrow,
  title,
  description,
  tone = 'surface',
  align = 'left',
  class: className = '',
} = Astro.props

const tones = {
  surface: 'bg-surface text-ink',
  white: 'bg-white text-ink',
  brand: 'bg-brand-900 text-white',
}

const isDark = tone === 'brand'
---

<section class={`py-14 sm:py-20 ${tones[tone]} ${className}`}>
  <Container>
    {
      (eyebrow || title || description) && (
        <header class={`mb-10 max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''}`}>
          {eyebrow && (
            <p
              class={`mb-2 text-xs font-semibold tracking-[0.14em] uppercase ${isDark ? 'text-gold-400' : 'text-gold-700'}`}
            >
              {eyebrow}
            </p>
          )}
          {title && <h2 class="text-3xl font-semibold sm:text-4xl">{title}</h2>}
          {description && (
            <p class={`mt-3 text-base ${isDark ? 'text-white/70' : 'text-ink-soft'}`}>
              {description}
            </p>
          )}
        </header>
      )
    }
    <slot />
  </Container>
</section>
