---
interface Props {
  name: string
  label: string
  hint?: string
  checked?: boolean
  class?: string
  [key: string]: unknown
}

const { name, label, hint, checked = false, class: className = '', ...rest } = Astro.props
const id = `field-${name}`
---

<div class={`flex items-start gap-2.5 ${className}`}>
  <input
    id={id}
    name={name}
    type="checkbox"
    checked={checked}
    class="mt-0.5 size-4.5 shrink-0 rounded border-brand-300 text-ink accent-brand-900"
    {...rest}
  />
  <div class="flex flex-col gap-0.5">
    <label for={id} class="text-sm text-ink">{label}</label>
    {hint && <p class="text-xs text-ink-muted">{hint}</p>}
  </div>
</div>
