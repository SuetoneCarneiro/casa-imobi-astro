---
import Field from './Field.astro'

interface Props {
  name: string
  label: string
  rows?: number
  hint?: string
  error?: string
  required?: boolean
  class?: string
  [key: string]: unknown
}

const {
  name,
  label,
  rows = 4,
  hint,
  error,
  required = false,
  class: className = '',
  ...rest
} = Astro.props

const id = `field-${name}`
---

<Field id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <textarea
    id={id}
    name={name}
    rows={rows}
    required={required}
    class={`w-full resize-y rounded-lg border bg-white px-3.5 py-2.5 text-[15px] text-ink placeholder:text-ink-muted/60 focus:outline-none ${
      error ? 'border-red-400' : 'border-brand-200 hover:border-brand-300'
    }`}
    aria-invalid={error ? 'true' : undefined}
    {...rest}></textarea>
</Field>
